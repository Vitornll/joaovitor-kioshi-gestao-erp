{
  "name": "kioshi-gestao-desktop",
  "version": "0.1.0",
  "description": "Sistema de gestão da Kioshi Controle de Pragas",
  "author": "Kioshi Controle de Pragas",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish=never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kioshi.gestao",
    "productName": "Kioshi Gestão",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "web-dist/**/*"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kioshi Gestão"
    }
  }
}
